{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "prisma validate --config=prisma7.config.ts && prisma generate --config=prisma7.config.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx --tsconfig tsconfig.json prisma/seed.ts",
    "dbpush": "prisma db push --config=prisma7.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.1.0",
    "lucide-react": "^0.563.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  }
}