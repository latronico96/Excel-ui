generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailVerified  DateTime?
  onboardingCompleted Boolean @default(false)
  defaultInvestmentPercentage Decimal @default(50) @db.Decimal(5, 2)
  titheEnabled Boolean @default(false)
  tithePercentage Decimal @default(10) @db.Decimal(5, 2)
  titheBase String @default("NET_INCOME")
  
  accounts       Account[]
  expenses       Expense[]
  expenseTypes   ExpenseType[]
  incomes        Income[]
  movements      Movement[]
  paymentMethods PaymentMethod[]
  sessions       Session[]
  recurringExpenses RecurringExpense[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ExpenseType {
  id        String    @id @default(cuid())
  userId    String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
}

model Income {
  userId               String?
  investmentPercentage Decimal         @default(0) @db.Decimal(5, 2)
  movementId           String          @id
  movement             Movement        @relation(fields: [movementId], references: [id], onDelete: Cascade)
  user                 User?           @relation(fields: [userId], references: [id])
  payments             IncomePayment[]
}

model IncomePayment {
  id                   String        @id @default(cuid())
  incomeId             String
  paymentMethodId      String
  amount               Decimal       @db.Decimal(12, 2)
  commissionPercentage Decimal       @default(0) @db.Decimal(5, 2)
  commissionAmount     Decimal       @default(0) @db.Decimal(12, 2)
  netAmount            Decimal       @default(0) @db.Decimal(12, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  income               Income        @relation(fields: [incomeId], references: [movementId], onDelete: Cascade)
  paymentMethod        PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([incomeId, paymentMethodId])
  @@index([incomeId])
  @@index([paymentMethodId])
}

model Movement {
  id          String       @id @default(cuid())
  userId      String
  type        MovementType
  amount      Decimal      @db.Decimal(12, 2)
  date        DateTime
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  expense     Expense?
  income      Income?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpensePayment RecurringExpensePayment?

  @@index([userId])
  @@index([userId, date])
}

model Expense {
  userId          String?
  expenseTypeId   String
  paymentMethodId String
  movementId      String        @id
  expenseType     ExpenseType   @relation(fields: [expenseTypeId], references: [id])
  movement        Movement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id                          String          @id @default(cuid())
  userId                      String
  name                        String
  active                      Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  defaultCommissionPercentage Decimal         @default(0) @db.Decimal(5, 2)
  expenses                    Expense[]
  incomePayments              IncomePayment[]
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
}

enum MovementType {
  INGRESO
  EGRESO
}

model RecurringExpense {
  id                 String   @id @default(cuid())
  userId             String

  name               String
  amount             Decimal? @db.Decimal(12, 2)
  dueDay             Int?
  active             Boolean  @default(true)

  expenseTypeId      String
  paymentMethodId    String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseType        ExpenseType  @relation(fields: [expenseTypeId], references: [id])
  paymentMethod      PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  payments           RecurringExpensePayment[]

  @@index([userId])
  @@index([expenseTypeId])
  @@index([paymentMethodId])
}

model RecurringExpensePayment {
  id                 String   @id @default(cuid())

  recurringExpenseId String
  movementId         String   @unique

  period             String
  amount             Decimal  @db.Decimal(12, 2)
  paidAt             DateTime

  createdAt          DateTime @default(now())

  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  movement           Movement         @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([recurringExpenseId, period])
  @@index([recurringExpenseId])
}
