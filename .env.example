# Google OAuth 2.0 Credentials
# Get them from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=vuestro_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=vuestro_client_secret
# PostgreSQL (default adapter). Use a local development database here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excel_ui?schema=public

# NextAuth Configuration
# En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
USE_SQLITE=false
NEXT_PUBLIC_APP_TITLE=Excel-ui

